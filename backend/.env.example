DATABASE_URL="postgresql://postgres@localhost:5432/jms"
DJANGO_SECRET_KEY="replace-this-in-development"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Use a separate stable secret in production. Changing it signs out all devices.
AUTH_SESSION_HASH_KEY="replace-with-a-long-random-secret"
AUTH_SESSION_ACTIVITY_THROTTLE_SECONDS="300"
AUTH_SESSION_RETENTION_DAYS="90"
AUTH_LOGIN_EVENT_RETENTION_DAYS="180"
AUTH_LOGIN_EVENT_LIMIT="100"
# Comma-separated IPs or CIDRs of reverse proxies allowed to supply X-Forwarded-For.
AUTH_TRUSTED_PROXY_IPS=""
# Optional GeoLite2 City database. If omitted, common system locations and
# backend/data/GeoLite2-City.mmdb are detected automatically.
AUTH_GEOIP2_DATABASE=""
